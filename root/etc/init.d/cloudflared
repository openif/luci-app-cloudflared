#!/bin/sh /etc/rc.common
# Copyright (C) 2024-2026 luci-app-cloudflared contributors
# Licensed under Apache License 2.0

USE_PROCD=1
START=99

CONF="cloudflared"
PROG="/usr/bin/cloudflared"

append_param_arg() {
	local opt="$1"
	local default_val="$2"
	local flag="$opt"
	case "$opt" in
		edge_bind_address) flag="edge-bind-address" ;;
		edge_ip_version) flag="edge-ip-version" ;;
		grace_period) flag="grace-period" ;;
	esac
	local value
	config_get value "config" "$opt" "$default_val"
	[ -n "$value" ] && procd_append_param command "--$flag" "$value"
}

check_log_size() {
	local logfile="$1"
	if [ -f "$logfile" ]; then
		local size=$(wc -c < "$logfile" 2>/dev/null || echo 0)
		# If log exceeds 2MB (2097152 bytes), keep last 1500 lines
		if [ "$size" -gt 2097152 ]; then
			tail -n 1500 "$logfile" > "${logfile}.tmp" 2>/dev/null && mv -f "${logfile}.tmp" "$logfile"
		fi
	fi
}

start_service() {
	config_load "$CONF"

	local enabled mode token config_file cert_file logfile protocol
	config_get_bool enabled "config" "enabled" 0
	[ "$enabled" -eq 1 ] || return 1

	config_get mode "config" "mode" "token"
	config_get token "config" "token"
	config_get config_file "config" "config"
	config_get cert_file "config" "origincert"
	config_get logfile "config" "logfile" "/var/log/cloudflared.log"
	config_get protocol "config" "protocol" "http2"

	# Check and rotate log to protect memory filesystem
	check_log_size "$logfile"
	touch "$logfile"
	chmod 644 "$logfile"

	procd_open_instance "$CONF"

	# Security: Inject Token via environment variable to prevent 'ps' process table leaks
	if [ "$mode" = "token" ] || [ -z "$mode" ]; then
		[ -z "$token" ] && return 1
		procd_set_param env TUNNEL_TOKEN="$token"
	fi

	procd_set_param command "$PROG"
	procd_append_param command "--logfile" "$logfile"
	procd_append_param command "tunnel"
	procd_append_param command "--no-autoupdate"

	# Protocol configuration
	[ "$protocol" != "auto" ] && [ -n "$protocol" ] && procd_append_param command "--protocol" "$protocol"

	# Local config mode parameters
	if [ "$mode" = "local" ]; then
		[ -n "$config_file" ] && [ -f "$config_file" ] && procd_append_param command "--config" "$config_file"
		[ -n "$cert_file" ] && [ -f "$cert_file" ] && procd_append_param command "--origincert" "$cert_file"
	fi

	append_param_arg "edge_bind_address"
	append_param_arg "edge_ip_version"
	append_param_arg "grace_period"
	append_param_arg "region"
	append_param_arg "retries"
	append_param_arg "tag"
	append_param_arg "metrics"
	append_param_arg "loglevel" "info"

	procd_append_param command "run"

	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_close_instance
}

stop_service() {
	killall cloudflared 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
	procd_add_interface_trigger "interface.*.up" "wan" /etc/init.d/cloudflared restart
}
